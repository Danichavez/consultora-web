# Plantilla de configuración — copiar a .env.local y completar.
# .env.local NO se commitea. En producción, cargar estas variables en Vercel.

# --- Sitio ---
# Dominio público del sitio (sin barra final). Pendiente: confirmar el dominio
# definitivo con Daniela. En preview de Vercel puede quedar la URL provisional.
NEXT_PUBLIC_SITE_URL=https://danielachavez.cl

# --- Formulario de contacto (Resend) ---
# API key de Resend. Secreta: nunca usar prefijo NEXT_PUBLIC_ ni loguearla.
RESEND_API_KEY=
# Remitente verificado en Resend. Mientras no haya dominio propio verificado,
# Resend permite usar onboarding@resend.dev para pruebas.
CONTACTO_FROM=onboarding@resend.dev
# Destinatario de los leads (la casilla de Daniela).
CONTACTO_TO=danichavez1882@gmail.com

# --- Integraciones ---
# Link de la discovery call de 30 min. Si queda vacío, la UI cae al mailto.
NEXT_PUBLIC_CALENDLY_URL=
# Google Analytics 4. Si queda vacío, no se inyecta el script.
NEXT_PUBLIC_GA_ID=
